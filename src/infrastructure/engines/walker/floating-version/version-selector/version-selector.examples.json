{
  "flag": [
    {
      "name": "floating lock-independent version",
      "fileName": "package.json",
      "source": "{\n  \"devDependencies\": {\n    \"some-tool\": \"^1.2.3\"\n  }\n}",
      "expectedLines": [3]
    },
    {
      "name": "unpinned action and runtime",
      "fileName": ".github/workflows/ci.yml",
      "source": "- uses: actions/checkout@v4\n  node-version: lts",
      "expectedLines": [1, 2]
    },
    {
      "name": "package manager major selector",
      "fileName": "package.json",
      "source": "{\n  \"packageManager\": \"pnpm@10\"\n}",
      "expectedLines": [2]
    }
  ],
  "allow": [
    {
      "name": "exact version",
      "fileName": "package.json",
      "source": "{\"devDependencies\":{\"some-tool\":\"1.2.3\"}}",
      "expectedLines": []
    },
    {
      "name": "pinned action and runtime",
      "fileName": ".github/workflows/ci.yml",
      "source": "- uses: actions/checkout@0123456789abcdef0123456789abcdef01234567\n  node-version: '22.18.0'",
      "expectedLines": []
    },
    {
      "name": "exact package manager with a hash suffix",
      "fileName": "package.json",
      "source": "{\"packageManager\":\"pnpm@10.34.9+sha512.0123456789abcdef\"}",
      "expectedLines": []
    },
    {
      "name": "workspace, file and exact prerelease selectors",
      "fileName": "package.json",
      "source": "{\"devDependencies\":{\"workspace-tool\":\"workspace:*\",\"file-tool\":\"file:../tool\",\"preview\":\"1.2.3-rc.1+build\"}}",
      "expectedLines": []
    },
    {
      "name": "compatibility ranges offered by a published package",
      "fileName": "package.json",
      "source": "{\"dependencies\":{\"react\":\"^19.0.0\"},\"peerDependencies\":{\"react-dom\":\"^19.0.0\"}}",
      "expectedLines": []
    }
  ]
}
