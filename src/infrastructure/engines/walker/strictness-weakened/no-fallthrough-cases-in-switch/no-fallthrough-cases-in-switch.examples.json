{
  "flag": [
    {
      "name": "noFallthroughCasesInSwitch set to false",
      "fileName": "packages/a/tsconfig.json",
      "source": "{\n  \"compilerOptions\": {\n    \"noFallthroughCasesInSwitch\": false\n  }\n}\n",
      "expectedLines": [1]
    },
    {
      "name": "noFallthroughCasesInSwitch restated as true",
      "fileName": "tsconfig.json",
      "source": "{ \"compilerOptions\": { \"target\": \"ESNext\", \"noFallthroughCasesInSwitch\": true } }\n",
      "expectedLines": [1]
    },
    {
      "name": "noFallthroughCasesInSwitch set to false under the second edition",
      "fileName": "packages/a/tsconfig.json",
      "source": "{\n  \"compilerOptions\": {\n    \"noFallthroughCasesInSwitch\": false\n  }\n}\n",
      "expectedLines": [1],
      "edition": "2"
    },
    {
      "name": "a base that cannot be read",
      "fileName": "packages/a/tsconfig.json",
      "source": "{ \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"target\": \"ESNext\" } }\n",
      "expectedLines": [1],
      "edition": "2"
    },
    {
      "name": "noFallthroughCasesInSwitch unset with no base",
      "fileName": "packages/b/tsconfig.json",
      "source": "{ \"compilerOptions\": { \"outDir\": \"dist\", \"target\": \"ESNext\" } }\n",
      "expectedLines": [1],
      "edition": "2"
    }
  ],
  "allow": [
    {
      "name": "inherits the shared base",
      "fileName": "packages/a/tsconfig.json",
      "source": "{ \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"target\": \"ESNext\" } }\n",
      "expectedLines": []
    },
    {
      "name": "only other options set",
      "fileName": "packages/b/tsconfig.json",
      "source": "{ \"compilerOptions\": { \"outDir\": \"dist\", \"target\": \"ESNext\" } }\n",
      "expectedLines": []
    },
    {
      "name": "tsconfig.base.json is not read",
      "fileName": "tsconfig.base.json",
      "source": "{ \"compilerOptions\": { \"noFallthroughCasesInSwitch\": true } }\n",
      "expectedLines": []
    },
    {
      "name": "tsconfig.base.json is not read under the second edition",
      "fileName": "tsconfig.base.json",
      "source": "{ \"compilerOptions\": { \"noFallthroughCasesInSwitch\": false } }\n",
      "expectedLines": [],
      "edition": "2"
    },
    {
      "name": "a solution-style config that compiles no files",
      "fileName": "tsconfig.json",
      "source": "{ \"files\": [], \"references\": [{ \"path\": \"./tsconfig.app.json\" }, { \"path\": \"./tsconfig.node.json\" }] }\n",
      "expectedLines": [],
      "edition": "2"
    }
  ]
}
