{
  "version": 2,
  "anchor": {
    "kind": "keyword",
    "keyword": "class"
  },
  "settings": {
    "pluginNamespace": "hone",
    "pluginModule": "eslint-plugin.ts",
    "rule": "no-extraneous-class",
    "options": [
      {
        "allowConstructorOnly": true,
        "allowEmpty": true,
        "allowStaticOnly": false,
        "allowWithDecorator": true
      }
    ]
  },
  "implementation": {
    "symptom": "authored-class-or-this",
    "check": "class-keyword"
  }
}
