{
  "version": 2,
  "settings": {
    "rule": "no-extraneous-class",
    "options": [
      {
        "allowConstructorOnly": true,
        "allowEmpty": true,
        "allowStaticOnly": false,
        "allowWithDecorator": true
      }
    ]
  },
  "implementation": {
    "symptom": "authored-class-or-this",
    "check": "class-keyword"
  }
}
