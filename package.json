{
  "version": "2.2.0",
  "private": true,
  "description": "Runs a project's selected disciplines against its own files.",
  "keywords": [
    "code-quality",
    "disciplines",
    "eslint",
    "lint",
    "typescript"
  ],
  "license": "MIT-0",
  "author": "Helen G",
  "type": "module",
  "scripts": {
    "typecheck:eslint-9": "tsc --noEmit -p tsconfig.eslint-9.json",
    "typecheck:eslint-10": "tsc --noEmit -p tsconfig.eslint-10.json",
    "typecheck": "pnpm run typecheck:eslint-9 && pnpm run typecheck:eslint-10",
    "format": "oxfmt && oxfmt",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm run typecheck && oxfmt --check && vitest run --config vitest.config.ts",
    "self-check": "node delivery/self-check/self-check.ts check --repo .",
    "install-proof": "node delivery/install-proof/install-proof.ts",
    "speed-baseline": "node delivery/speed-baseline/speed-baseline.ts",
    "build-package": "node delivery/packaging/building/build-package.ts",
    "pack-package": "node delivery/packaging/packing/pack-package.ts",
    "package-determinism": "node delivery/packaging/packing/check-package-determinism.ts",
    "pull-request-title": "node delivery/pull-request-title/pull-request-title-command.ts",
    "release-pull-request": "node delivery/release/release-pull-request-command.ts"
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.7.3",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "esbuild": "0.25.12",
    "eslint": "10.15.0",
    "eslint-9": "npm:eslint@9.39.5",
    "jiti": "2.7.0",
    "oxfmt": "0.79.0",
    "typescript": "6.0.3",
    "typescript-floor": "npm:typescript@4.8.4",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.39.5 || ^10.15.0",
    "typescript": ">=4.8.4 <7.0.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
